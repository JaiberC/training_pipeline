# Copiar a .env y ajustar. .env NO se versiona.

# --- Postgres ---
DBNAME=trainpipe
DBUSER=trainpipe
DBPASSWORD=cambiar_en_produccion

# Ruta base del host para los bind mounts. El directorio debe existir ANTES
# del primer `up` y tener el dueño correcto (postgres corre como uid 999):
#   mkdir -p $DOCKER_PATH/postgres/data
DOCKER_PATH=/home/jaiber/QAingenieros/scripts/yolo/training_pipeline/data

# --- Servicio ---
API_PORT=8000

# Memoria compartida del contenedor del worker. PyTorch pasa los tensores de los
# dataloaders por /dev/shm, y Docker deja 64 MB, que no bastan para workers>0:
# los procesos se quedan bloqueados y el entrenamiento aparece parado sin error.
# 2gb cubre de sobra hasta 640 px con batch 32. NO lo bajes sin medir.
SHM_SIZE=2gb

# Nivel de log del worker. INFO por defecto. Ponlo a DEBUG cuando algo falle: a
# INFO se descarta la salida del entrenamiento y solo llega el error secundario.
WORKER_LOG_LEVEL=INFO

# uid/gid del usuario en el host. api y worker corren con estos ids para que los
# ficheros que crean en los volumenes sean escribibles desde el host sin sudo:
#   echo "HOST_UID=$(id -u)"  >> .env
#   echo "HOST_GID=$(id -g)"  >> .env
HOST_UID=1000
HOST_GID=1000

# --- Imagen ---
# REGISTRY debe ser tu usuario de Docker Hub: <user>/tp-api y <user>/tp-worker
REGISTRY=local
TAG=latest